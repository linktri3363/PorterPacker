# PorterPacker .gitignore

# Job data files in data/ are tracked on purpose (they double as a backup).
# Exports from //po export are scratch files, so keep those out.
*.lua.bak
*.lua.old

# Personal character exports (//po export writes data/export_Name_JOB.lua)
data/export_*.lua

# Temporary files
*.tmp
*.temp

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/

# Logs
*.log

# Backup files
*.backup
